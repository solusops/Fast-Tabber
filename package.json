{
  "name": "fast-tabber-toolkit",
  "version": "1.0.0",
  "description": "Local-first Chrome tabs and bookmarks through MCP and your existing AI agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solusops/Fast-Tabber.git"
  },
  "bin": {
    "fast-tabber": "./cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "cli.js",
    "runtime.js",
    "opencode-plugin.js",
    "install.ps1",
    "install.cmd",
    "tabber.ps1",
    "pyproject.toml",
    "requirements.lock.txt",
    "fast_tabber/*.py",
    "extension/manifest.json",
    "extension/background.js",
    "extension/bookmarks.js",
    "extension/content.js",
    "extension/export.js",
    "extension/popup.html",
    "extension/popup.css",
    "extension/popup.js",
    ".agents/skills/fast-tabber/SKILL.md",
    "PRIVACY.md",
    "fast_tabber/setup.html",
    "fast_tabber/setup-page.js",
    "fast_tabber/setup-page.css",
    ".agents/plugins/marketplace.json",
    "plugins/fast-tabber/.codex-plugin/plugin.json",
    "plugins/fast-tabber/.mcp.json",
    "plugins/fast-tabber/skills/fast-tabber/SKILL.md"
  ],
  "scripts": {
    "test": "node tests/test_extension.mjs && node tests/test_bookmarks.mjs && node tests/test_popup.mjs && node tests/test_pairing.mjs && node tests/test_runtime.mjs"
  },
  "type": "module",
  "main": "./opencode-plugin.js",
  "exports": "./opencode-plugin.js"
}
