{
  "manifest_version": 3,
  "name": "Fast-Tabber",
  "version": "0.4.2",
  "description": "Manage and search Chrome tabs through local AI agents.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabs", "tabGroups", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8765"
  }
}
