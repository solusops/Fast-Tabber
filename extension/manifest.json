{
  "manifest_version": 3,
  "name": "Fast-Tabber",
  "version": "0.7.0",
  "description": "Manage and search Chrome tabs through local AI agents.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["tabs", "tabGroups", "scripting", "debugger", "alarms", "storage"],
  "optional_permissions": ["bookmarks"],
  "action": { "default_popup": "popup.html", "default_title": "Fast-Tabber: export tabs and bookmarks" },
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8765"
  }
}
